# Copy to .env — NEVER commit the real one.
OPENCODE_API_KEY=
# Both default to muse-spark-1.3-contributor (exact Go model id).
# Split later if you add a cheaper model: detective fires per match
# (volume), writer fires per day. API base is the Go endpoint, NOT
# api.opencode.ai — Go keys 404 there.
OPENCODE_API_BASE=https://opencode.ai/zen/go/v1
OPENCODE_API_PATH=/responses
DETECT_MODEL=muse-spark-1.3-contributor
WRITER_MODEL=muse-spark-1.3-contributor
DB_URL=postgresql://urdheim:***@localhost:5432/urdheim
# Read path: GetXAPI key (dashboard at getxapi.com, pay-per-call reads;
# monitor webhooks need a Monitoring plan — confirm cost before enabling).
# twitterapi.io key kept as fallback transport (TWITTERAPI_KEY=).
GETXAPI_KEY=
GETXAPI_WEBHOOK_SECRET=
WEBHOOK_URL=https://urdheim.example.com/hook
# Write path: Heimdall poster shell cookies for uny-x post (poster never scrapes).
POSTER_COOKIES=/run/cookies-poster.json
# Fallback: inline cookie JSON (single line) if no file. Path wins when both set.
# POSTER_COOKIES_JSON=

# --- snitch door (Cloudflare Turnstile; test keys always pass, replace for prod)
# get real keys: dash.cloudflare.com -> Turnstile -> add site
TURNSTILE_SECRET=1x0000000000000000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITEKEY=1x00000000000000000000AA
# --- persistence (point at a volume in prod so redeploys keep state)
# SEEN_PATH=/data/seen.json (listener: already-replied ids)
# QUEUE_PATH=/data/q.jsonl (poll queue)
# DONE_PATH=/data/q.done (classified ids)
# BUDGET_LEDGER=/data/spend.jsonl (spend ledger)
# --- web
NEXT_PUBLIC_API=http://localhost:8091
# CORS_ORIGINS=https://yourdomain.com,https://api.yourdomain.com
# --- worker loops (dokploy services poll/snap)
# POLL_EVERY=600
# SNAP_EVERY=900
# SNAP_LIMIT=200
APP_URL= # public base url, used in signin nudge link

# X oauth (signin). values from console.x.com -> your app -> keys.
# callback to register there: {APP_URL}/api/auth/callback
# (local: http://localhost:8091/api/auth/callback)
X_CLIENT_ID=
X_CLIENT_SECRET=
# callback override when the api is not on the public url (local dev).
OAUTH_CALLBACK=
# random string, signs login cookies. generate: python3 -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=

# vision fallback (derivation match stack step 3)
MODEL_API_KEY=
VISION_MODEL=muse-spark-1.3
