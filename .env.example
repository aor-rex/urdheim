# Copy to .env — NEVER commit the real one.
OPENCODE_API_KEY=
DETECT_MODEL=
WRITER_MODEL=
DB_URL=postgresql://urdheim:***@localhost:5432/urdheim
# Read path: twitterapi.io key (dashboard at twitterapi.io, pay-as-you-go,
# set a monthly spending cap). No cookies, no shells for reading.
TWITTERAPI_KEY=
# Write path: Heimdall poster shell cookies for uny-x post (poster never scrapes).
POSTER_COOKIES=/run/cookies-poster.json
# Fallback: inline cookie JSON (single line) if no file. Path wins when both set.
# POSTER_COOKIES_JSON=
